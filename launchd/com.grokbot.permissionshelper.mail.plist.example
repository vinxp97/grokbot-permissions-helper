<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.grokbot.permissionshelper.mail</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USERNAME/Applications/Grokbot_Permissions_Helper.app/Contents/MacOS/GrokbotPermissionsHelper</string>
    <string>--mail-fetch</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>StandardOutPath</key>
  <string>/tmp/grokbot-mail-fetch.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/grokbot-mail-fetch.err</string>
</dict>
</plist>
